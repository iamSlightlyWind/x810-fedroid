#!/sbin/sh
# Host-built X810 boot-only TWRP installer. Writes only /dev/block/by-name/boot.
# No repartition, formats, other partitions, vbmeta changes, or reboot.

OUTFD=$2
ZIPFILE=$3
TMP=/tmp/x810-boot-only.$$
EXPECTED_SIZE=100663296

ui_print() {
    echo "ui_print $1" >> /proc/self/fd/$OUTFD
    echo "ui_print" >> /proc/self/fd/$OUTFD
}

abort() {
    ui_print "ERROR: $1"
    ui_print "No automatic reboot. If the boot write started, restore boot.img from the local backup ZIP in TWRP."
    rm -rf "$TMP"
    exit 1
}

[ -n "$ZIPFILE" ] && [ -f "$ZIPFILE" ] || abort "missing installer ZIP"
for cmd in getprop unzip sha256sum blockdev dd cat awk wc tr mkdir rm sync; do
    command -v "$cmd" >/dev/null 2>&1 || abort "required recovery tool is missing: $cmd"
done

# Shared gts9p recovery builds serve multiple models. Require the X810 model
# and at least one independent X810 bootloader/model property.
DEVICE_CODENAME="$(getprop ro.product.device)"
EM_MODEL="$(getprop ro.boot.em.model)"
BOOTLOADER="$(getprop ro.bootloader)"
CMDLINE="$(cat /proc/cmdline 2>/dev/null)"
case "$DEVICE_CODENAME" in gts9p|gts9pwifi) ;; *) abort "expected X810 recovery codename; got '$DEVICE_CODENAME'" ;; esac
[ -z "$EM_MODEL" ] || [ "$EM_MODEL" = SM-X810 ] || abort "recovery model conflicts with SM-X810 ('$EM_MODEL')"
case "$BOOTLOADER" in
    '') BL_PROP_CONFIRMED=0 ;;
    X810*) BL_PROP_CONFIRMED=1 ;;
    *) abort "recovery bootloader conflicts with SM-X810 ('$BOOTLOADER')" ;;
esac
case " $CMDLINE " in *" androidboot.em.model=SM-X810 "*) MODEL_CONFIRMED=1 ;; *) MODEL_CONFIRMED=0 ;; esac
case " $CMDLINE " in *" androidboot.bootloader=X810"*) BL_CONFIRMED=1 ;; *) BL_CONFIRMED=0 ;; esac
if [ "$EM_MODEL" != SM-X810 ] && [ "$BL_PROP_CONFIRMED" -ne 1 ] && \
   [ "$MODEL_CONFIRMED" -ne 1 ] && [ "$BL_CONFIRMED" -ne 1 ]; then
    abort "cannot positively identify SM-X810 from recovery properties or command line"
fi

BB=/dev/block/by-name
TARGET="$BB/boot"
[ -b "$TARGET" ] || abort "missing boot partition $TARGET"
actual_size=$(blockdev --getsize64 "$TARGET" 2>/dev/null) || abort "cannot read boot geometry"
[ "$actual_size" = "$EXPECTED_SIZE" ] || abort "boot geometry mismatch (expected $EXPECTED_SIZE, got $actual_size)"
ro=$(blockdev --getro "$TARGET" 2>/dev/null) || abort "cannot read boot write status"
[ "$ro" = 0 ] || abort "boot is read-only; no image has been written"

mkdir -p "$TMP" || abort "cannot create staging directory"
trap 'rm -rf "$TMP"' EXIT
unzip -p "$ZIPFILE" SHA256SUMS > "$TMP/SHA256SUMS" || abort "ZIP has no SHA256SUMS"
expected_hash=$(awk '$2 == "boot.img" { n++; hash=$1 } END { if (n == 1) print hash }' "$TMP/SHA256SUMS")
case "$expected_hash" in ''|*[!0-9a-f]*) abort "invalid or missing boot.img checksum" ;; esac
[ "${#expected_hash}" -eq 64 ] || abort "invalid boot.img checksum length"
unzip -p "$ZIPFILE" boot.img > "$TMP/boot.img" || abort "cannot extract boot.img"
actual_size=$(wc -c < "$TMP/boot.img" | tr -d ' ')
[ "$actual_size" = "$EXPECTED_SIZE" ] || abort "boot.img has the wrong size"
actual_hash=$(sha256sum "$TMP/boot.img" | awk '{print $1}')
[ "$actual_hash" = "$expected_hash" ] || abort "boot.img checksum mismatch"

ui_print "X810 identity and boot partition geometry confirmed. Only boot will be written."
dd if="$TMP/boot.img" of="$TARGET" bs=4M || abort "boot write failed"
sync || abort "sync failed after boot write"
dd if="$TARGET" of="$TMP/boot.readback.img" bs=4M 2>/dev/null || abort "cannot read boot back"
actual_size=$(wc -c < "$TMP/boot.readback.img" | tr -d ' ')
[ "$actual_size" = "$EXPECTED_SIZE" ] || abort "boot read-back size mismatch"
actual_hash=$(sha256sum "$TMP/boot.readback.img" | awk '{print $1}')
[ "$actual_hash" = "$expected_hash" ] || abort "boot read-back checksum mismatch"

sync
ui_print "boot read-back verified. No other partition was written; no reboot performed."
exit 0
