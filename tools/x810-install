@dataclass
class Check:
    label: str
    state: str
    detail: str


def command(argv: list[str], timeout: int = 15) -> subprocess.CompletedProcess[str]:
    return subprocess.run(argv, text=True, capture_output=True, timeout=timeout, check=False)


def adb_serials(adb_output: str) -> list[tuple[str, str]]:
    return [item for item in adb_devices(adb_output) if item[1] in {"device", "recovery", "sideload"}]


def adb_devices(adb_output: str) -> list[tuple[str, str]]:
    """Return every ADB target/state pair, including actionable failures."""
    found: list[tuple[str, str]] = []
    for line in adb_output.splitlines()[1:]:
        fields = line.split()
        if len(fields) >= 2 and fields[1] in {"device", "recovery", "sideload", "unauthorized", "offline"}:
            found.append((fields[0], fields[1]))
    return found


def linux_ids(path: Path = Path("/etc/os-release")) -> set[str]:
    """Read distro IDs without sourcing shell code from os-release."""
    values: set[str] = set()
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError:
        return values
    for line in lines:
        key, separator, value = line.partition("=")
        if not separator or key not in {"ID", "ID_LIKE"}:
            continue
        try:
            words = shlex.split(value, comments=False, posix=True)
        except ValueError:
            continue
        if key == "ID_LIKE":
            values.update(word.lower() for part in words for word in part.split())
        else:
            values.update(word.lower() for word in words)
    return values


def package_hint(program: str, ids: set[str] | None = None) -> str:
    """Return copyable package-manager guidance; never install host packages."""
    ids = linux_ids() if ids is None else ids
    if program == "adb":
        commands = []
        if ids & {"fedora", "rhel", "centos", "rocky", "almalinux"}:
            commands.append("sudo dnf install android-tools")
        if ids & {"debian", "ubuntu", "linuxmint", "pop", "elementary"}:
            commands.append("sudo apt install adb")
        if ids & {"arch", "manjaro", "endeavouros"}:
            commands.append("sudo pacman -S android-tools")
        if ids & {"opensuse", "opensuse-tumbleweed", "suse", "sles"}:
            commands.append("sudo zypper install android-tools")
        if not commands:
            commands.append("install Android Platform Tools (the adb package) with your Linux package manager")
        return "; ".join(commands)
    if program == "sha256sum":
        if ids & {"fedora", "rhel", "centos", "rocky", "almalinux"}:
            return "sudo dnf install coreutils"
        if ids & {"debian", "ubuntu", "linuxmint", "pop", "elementary"}:
            return "sudo apt install coreutils"
        if ids & {"arch", "manjaro", "endeavouros"}:
            return "sudo pacman -S coreutils"
        return "install coreutils with your Linux package manager"
    if program == "openssl":
        if ids & {"fedora", "rhel", "centos", "rocky", "almalinux"}:
            return "sudo dnf install openssl"
        if ids & {"debian", "ubuntu", "linuxmint", "pop", "elementary"}:
            return "sudo apt install openssl"
        if ids & {"arch", "manjaro", "endeavouros"}:
            return "sudo pacman -S openssl"
        if ids & {"opensuse", "opensuse-tumbleweed", "suse", "sles"}:
            return "sudo zypper install openssl"
        return "install openssl with your Linux package manager"
    return f"install {program} with your Linux package manager"


def adb_wait_hint(adb_output: str, serial: str | None = None) -> str:
    rows = adb_devices(adb_output)
    if serial:
        rows = [row for row in rows if row[0] == serial]
        if not rows:
            return f"{serial} is not listed; check the USB cable, then run `adb devices -l` again"
    if any(state == "unauthorized" for _, state in rows):
        return "unlock Android and approve the USB-debugging RSA prompt, or open TWRP and reconnect; rerun `doctor`"
    if any(state == "offline" for _, state in rows):
        return "reconnect the USB cable, then run `adb kill-server` and `adb start-server`; rerun `doctor`"
    if not rows:
        return "connect by USB; in Android enable USB debugging and approve its prompt, or open TWRP; rerun `doctor`"
    return "no usable ADB target; run `adb devices -l` and resolve its state before continuing"


def latest_release(opener=urllib.request.urlopen) -> dict[str, Any] | None:
    request = urllib.request.Request(
        RELEASE_API,
        headers={"Accept": "application/vnd.github+json", "User-Agent": "x810-install/0.1"},
    )
    try:
        with opener(request, timeout=12) as response:
            result = json.loads(response.read())
    except urllib.error.HTTPError as error:
        if error.code == 404:
            error.close()
            return None
        error.close()
        raise RuntimeError(f"GitHub returned HTTP {error.code}") from error
    except (urllib.error.URLError, TimeoutError, json.JSONDecodeError) as error:
        raise RuntimeError(f"could not read the GitHub release feed: {error}") from error
    if not isinstance(result, dict):
        raise RuntimeError("GitHub returned an unexpected release response")
    return result


def release_checks(release: dict[str, Any] | None) -> list[Check]:
    """Distinguish legacy full-set metadata from the clean-install bundle.

    ``port-release.json`` is retained for compatibility, but the current
    Tab Companion Fedora updater reads per-build releases produced by the
    support-package job in ``x810-fedora.yml``.
    A clean-install bundle is validated independently before install.
    """
    if release is None:
        return [
            Check("Legacy release index", "INFO", "no combined release is available to inspect; in-OS support updates are a separate release channel from x810-fedora.yml"),
            Check("From-stock install", "BLOCKED", "no validated X810 dual-boot installer package is available"),
        ]
    assets = release.get("assets", [])
    if not isinstance(assets, list):
        assets = []
    names = {
        item["name"] for item in assets
        if isinstance(item, dict) and isinstance(item.get("name"), str)
    }
    tag = release.get("tag_name", "latest")
    feed_required = {"port-release.json", "SHA256SUMS", "BUNDLE-SHA256SUMS"}
    if feed_required <= names:
        update = Check(
            "Legacy release index",
            "INFO",
            f"{tag} contains legacy port-release metadata; Tab Companion Fedora updates use the run-keyed support release from x810-fedora.yml, not this index",
        )
    else:
        missing = ", ".join(sorted(feed_required - names))
        update = Check("Legacy release index", "INFO", f"{tag} is missing legacy metadata {missing}; the Fedora support update is published separately by x810-fedora.yml")

    clean_bundles = sorted(name for name in names
                           if name.startswith("x810-fedora-sm-x810-")
                           and name.endswith(CLEAN_BUNDLE_SUFFIX))
    if len(clean_bundles) == 1:
        install = Check(
            "From-stock install",
            "CHECK",
            f"{tag} publishes {clean_bundles[0]}; manifest/target/hash validation runs before install",
        )
    elif len(clean_bundles) > 1:
        install = Check("From-stock install", "BLOCKED", f"{tag} has multiple clean bundles; expected exactly one")
    else:
        install = Check(
            "From-stock install",
            "BLOCKED",
            f"no {CLEAN_BUNDLE_SUFFIX} asset is published; updater RPMs cannot install Fedora from stock Android",
        )
    return [update, install]


def read_device(adb: str, serial: str, state: str) -> list[Check]:
    def prop(name: str) -> str:
        result = command([adb, "-s", serial, "shell", "getprop", name])
        return result.stdout.strip().replace("\r", "") if result.returncode == 0 else ""

    em_model = prop("ro.boot.em.model")
    product_model = prop("ro.product.model")
    bootloader = prop("ro.bootloader")
    device = prop("ro.product.device")
    build = prop("ro.build.display.id") or prop("ro.build.version.release")
    twrp = prop("ro.twrp.version")
    items = [Check("ADB target", "OK", f"{serial} ({state})")]
    identity_ok = (
        em_model == EXPECTED_MODEL
        or (product_model == EXPECTED_MODEL and device == EXPECTED_DEVICE)
        or (bootloader.startswith("X810") and device == EXPECTED_DEVICE)
    )
    if identity_ok:
        model = em_model or product_model or EXPECTED_MODEL
        items.append(Check("Tablet identity", "OK", f"{model} / {device or EXPECTED_DEVICE}"))
    else:
        items.append(Check("Tablet identity", "STOP", f"could not prove SM-X810 (em.model={em_model or '?'}, model={product_model or '?'}, device={device or '?'}, bootloader={bootloader or '?'})"))
    if twrp:
        items.append(Check("Recovery", "OK", f"TWRP {twrp}"))
        if identity_ok:
            items.extend(read_recovery_partitions(adb, serial))
    elif state == "recovery":
        items.append(Check("Recovery", "STOP", "ADB says recovery, but TWRP did not identify itself"))
    elif state == "device":
        items.append(Check("Recovery", "WAIT", f"Android {build or 'build unknown'}; manually enter TWRP and rerun `doctor` (wizard will not reboot)"))
    else:
        items.append(Check("Recovery", "WAIT", f"ADB state is {state}; TWRP recovery is required for a future install"))
    if state == "device":
        locked_property = prop("ro.boot.flash.locked")
        vbmeta_state = prop("ro.boot.vbmeta.device_state").lower()
        verified_state = prop("ro.boot.verifiedbootstate").lower()
        unlocked = locked_property == "0" or vbmeta_state == "unlocked" or verified_state == "orange"
        locked = locked_property == "1" or vbmeta_state == "locked"
        unlock_detail = "unlocked" if unlocked and not locked else ("locked" if locked else "unknown; Android boot properties did not prove unlock")
        items.append(Check("Bootloader", "OK" if unlocked and not locked else "STOP", unlock_detail))
        root = command([adb, "-s", serial, "shell", "su", "-c", "id -u"])
        root_ok = root.returncode == 0 and root.stdout.strip() == "0"
        items.append(Check("Android root", "OK" if root_ok else "STOP",
                           "`su -c id -u` returned 0" if root_ok else "root access through su is unavailable or denied"))
    return items


def read_recovery_partitions(adb: str, serial: str) -> list[Check]:
    """Read only the X810 GPT by-name nodes and their sizes from TWRP."""
    checks: list[Check] = []

    def shell(*args: str) -> subprocess.CompletedProcess[str]:
        return command([adb, "-s", serial, "shell", *args])

    for name, expected in X810_BOOT_PARTITIONS.items():
        path = f"/dev/block/by-name/{name}"
        result = shell("blockdev", "--getsize64", path)
        try:
            actual = int(result.stdout.strip()) if result.returncode == 0 else 0
        except ValueError:
            actual = 0
        state = "OK" if actual == expected else "STOP"
        detail = f"{actual:,} bytes" if actual == expected else f"expected {expected:,} bytes; got {result.stdout.strip() or 'unreadable'}"
        checks.append(Check(f"partition {name}", state, detail))

    userdata_path = "/dev/block/by-name/userdata"
    userdata_result = shell("blockdev", "--getsize64", userdata_path)
    try:
        userdata_bytes = int(userdata_result.stdout.strip()) if userdata_result.returncode == 0 else 0
    except ValueError:
        userdata_bytes = 0
    linuxroot_result = shell("sh", "-c", "test -b /dev/block/by-name/linuxroot && echo present || echo absent")
    linuxroot = linuxroot_result.stdout.strip() if linuxroot_result.returncode == 0 else "unknown"
    if userdata_bytes <= 0:
        checks.append(Check("userdata layout", "STOP", "could not read userdata partition size"))
    elif linuxroot == "absent" and userdata_bytes == X810_STOCK_USERDATA_BYTES:
        checks.append(Check("userdata layout", "OK", f"measured stock, unsplit layout ({userdata_bytes:,} bytes)"))
    elif linuxroot == "present":
        root_result = shell("blockdev", "--getsize64", "/dev/block/by-name/linuxroot")
        try:
            root_bytes = int(root_result.stdout.strip()) if root_result.returncode == 0 else 0
        except ValueError:
            root_bytes = 0
        state = "OK" if root_bytes > 0 else "STOP"
        checks.append(Check("userdata layout", state, f"linuxroot={'present' if root_bytes else 'unreadable'} ({root_bytes:,} bytes); userdata {userdata_bytes:,} bytes"))
    else:
        checks.append(Check("userdata layout", "STOP", f"unrecognized or unreadable geometry (userdata {userdata_bytes:,} bytes; linuxroot {linuxroot})"))
    return checks


def host_checks() -> list[Check]:
    checks = [Check("Host OS", "OK" if platform.system() == "Linux" else "STOP", platform.platform())]
    programs = (
        ("adb", True, package_hint("adb")),
        ("sha256sum", True, package_hint("sha256sum")),
        ("openssl", True, package_hint("openssl")),
        ("heimdall", False, "optional; one Download Mode flashing tool is needed later"),
        ("odin4", False, "optional; one Download Mode flashing tool is needed later"),
    )
    for program, required, hint in programs:
        path = shutil.which(program)
        detail = path or (f"not installed ({hint})" if required else hint)
        checks.append(Check(program, "OK" if path else ("STOP" if required else "INFO"), detail))
    return checks


def run_doctor(serial: str | None = None) -> tuple[list[Check], int]:
    checks = host_checks()
    adb = shutil.which("adb")
    if not adb:
        return checks, 2
    result = command([adb, "devices", "-l"])
    if result.returncode != 0:
        checks.append(Check("ADB server", "STOP", result.stderr.strip() or "adb devices failed"))
        return checks, 2
    targets = adb_serials(result.stdout)
    if serial:
        targets = [item for item in targets if item[0] == serial]
        if not targets:
            checks.append(Check("ADB target", "STOP", adb_wait_hint(result.stdout, serial)))
            return checks, 2
    elif len(targets) > 1:
        checks.append(Check("ADB target", "STOP", "multiple devices connected; rerun with --serial SERIAL"))
        return checks, 2
    elif not targets:
        checks.append(Check("ADB target", "WAIT", adb_wait_hint(result.stdout)))
        return checks, 1
    target_serial, state = targets[0]
    checks.extend(read_device(adb, target_serial, state))
    return checks, 2 if any(item.state == "STOP" for item in checks) else 0


def show_checks(checks: list[Check]) -> None:
    width = max((len(check.label) for check in checks), default=0)
    for check in checks:
        print(f"[{check.state:7}] {check.label:<{width}}  {check.detail}")


def twrp_identity(adb: str, serial: str, state: str, runner=None) -> tuple[dict[str, str], list[Check]]:
    """Require root ADB in the X810 TWRP environment; never reboot into it."""
    runner = command if runner is None else runner
    values: dict[str, str] = {}

    def shell(*args: str) -> str:
        result = runner([adb, "-s", serial, "shell", *args])
        return result.stdout.strip().replace("\r", "") if result.returncode == 0 else ""

    for key, prop in (
        ("twrp", "ro.twrp.version"),
        ("device", "ro.product.device"),
        ("model", "ro.boot.em.model"),
        ("bootloader", "ro.bootloader"),
    ):
        values[key] = shell("getprop", prop)
    values["uid"] = shell("id", "-u")
    values["cmdline"] = shell("cat", "/proc/cmdline")

    checks = [Check("ADB target", "OK", f"{serial} ({state})")]
    if state != "recovery":
        checks.append(Check("Recovery state", "STOP", f"expected TWRP recovery, got ADB state {state}"))
    else:
        checks.append(Check("Recovery state", "OK", "TWRP ADB recovery"))
    if values["twrp"]:
        checks.append(Check("TWRP", "OK", values["twrp"]))
    else:
        checks.append(Check("TWRP", "STOP", "ro.twrp.version is empty"))
    if values["device"] not in {"gts9p", "gts9pwifi"}:
        checks.append(Check("Recovery codename", "STOP", f"expected gts9p/gts9pwifi, got {values['device'] or '?'}"))
    else:
        checks.append(Check("Recovery codename", "OK", values["device"]))
    if values["model"] and values["model"] != EXPECTED_MODEL:
        checks.append(Check("Tablet model", "STOP", f"expected {EXPECTED_MODEL}, got {values['model']}"))
    elif values["bootloader"] and not values["bootloader"].startswith("X810"):
        checks.append(Check("Tablet bootloader", "STOP", f"expected X810 bootloader, got {values['bootloader']}"))
    elif values["model"] == EXPECTED_MODEL or values["bootloader"].startswith("X810") or "androidboot.em.model=SM-X810" in values["cmdline"]:
        checks.append(Check("Tablet identity", "OK", f"{values['model'] or values['bootloader'] or EXPECTED_MODEL}"))
    else:
        checks.append(Check("Tablet identity", "STOP", "TWRP does not expose a positive SM-X810 identity"))
    if values["uid"] == "0":
        checks.append(Check("Recovery privileges", "OK", "ADB shell is root"))
    else:
        checks.append(Check("Recovery privileges", "STOP", f"ADB shell uid is {values['uid'] or 'unknown'}, expected 0"))
    return values, checks


def adb_binary(adb: str, serial: str, remote_command: str, timeout: int = 45) -> bytes:
    """Read a small binary block through adb exec-out without text conversion."""
    try:
        result = subprocess.run(
            [adb, "-s", serial, "exec-out", "sh", "-c", remote_command],
            capture_output=True,
            timeout=timeout,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise RuntimeError(f"ADB binary read failed: {error}") from error
    if result.returncode != 0:
        detail = result.stderr.decode(errors="replace").strip()
        raise RuntimeError(detail or f"adb exec-out exited {result.returncode}")
    return result.stdout


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def save_gpt_backup(adb: str, serial: str, out_dir: Path, values: dict[str, str],
                    runner=None, binary_reader=None) -> list[Check]:
    """Capture all six X810 UFS GPTs (not partition payloads) to a new host folder."""
    runner = command if runner is None else runner
    binary_reader = adb_binary if binary_reader is None else binary_reader
    if out_dir.exists():
        raise RuntimeError(f"output already exists; refusing to overwrite: {out_dir}")
    if not out_dir.parent.exists():
        raise RuntimeError(f"parent directory does not exist: {out_dir.parent}")
    out_dir.mkdir(mode=0o700)
    (out_dir / "gpt").mkdir(mode=0o700)
    files: list[Path] = []
    inventory: dict[str, dict[str, Any]] = {}
    serial_tag = hashlib.sha256(serial.encode()).hexdigest()[:8]
    try:
        for disk, expected_bytes in X810_LUNS.items():
            node = f"/dev/block/{disk}"
            result = runner([adb, "-s", serial, "shell", "blockdev", "--getsize64", node])
            actual = result.stdout.strip().replace("\r", "") if result.returncode == 0 else ""
            if actual != str(expected_bytes):
                raise RuntimeError(f"{node} geometry mismatch: expected {expected_bytes} bytes, got {actual or 'unreadable'}")
            logical_result = runner([adb, "-s", serial, "shell", "cat", f"/sys/class/block/{disk}/queue/logical_block_size"])
            logical = logical_result.stdout.strip().replace("\r", "") if logical_result.returncode == 0 else ""
            if logical != str(GPT_CAPTURE_BLOCK):
                raise RuntimeError(f"{disk} logical block size mismatch: expected 4096, got {logical or 'unreadable'}")

            remote = f"/tmp/x810-gpt-{serial_tag}-{disk}.bin"
            gpt_backup = out_dir / "gpt" / f"{disk}-sgdisk.bin"
            try:
                backup_cmd = runner([adb, "-s", serial, "shell", "sgdisk", f"--backup={remote}", node], timeout=45)
                if backup_cmd.returncode != 0:
                    raise RuntimeError(f"sgdisk could not back up {disk}: {backup_cmd.stderr.strip() or backup_cmd.stdout.strip()}")
                pull = runner([adb, "-s", serial, "pull", remote, str(gpt_backup)], timeout=90)
            finally:
                runner([adb, "-s", serial, "shell", "rm", "-f", remote])
            if pull.returncode != 0 or not gpt_backup.is_file() or gpt_backup.stat().st_size < 1:
                raise RuntimeError(f"could not pull the {disk} GPT backup to the PC")
            files.append(gpt_backup)

            block_count = expected_bytes // GPT_CAPTURE_BLOCK
            first_cmd = f"dd if={node} bs={GPT_CAPTURE_BLOCK} count={GPT_CAPTURE_BYTES // GPT_CAPTURE_BLOCK} 2>/dev/null"
            last_cmd = f"dd if={node} bs={GPT_CAPTURE_BLOCK} skip={block_count - GPT_CAPTURE_BYTES // GPT_CAPTURE_BLOCK} count={GPT_CAPTURE_BYTES // GPT_CAPTURE_BLOCK} 2>/dev/null"
            first = binary_reader(adb, serial, first_cmd)
            last = binary_reader(adb, serial, last_cmd)
            if len(first) != GPT_CAPTURE_BYTES or len(last) != GPT_CAPTURE_BYTES:
                raise RuntimeError(f"{disk} GPT edge read length mismatch (first={len(first)}, last={len(last)})")
            first_path = out_dir / "gpt" / f"{disk}-first-1m.bin"
            last_path = out_dir / "gpt" / f"{disk}-last-1m.bin"
            first_path.write_bytes(first)
            last_path.write_bytes(last)
            files.extend((first_path, last_path))

            print_result = runner([adb, "-s", serial, "shell", "sgdisk", "--print", node], timeout=45)
            verify_result = runner([adb, "-s", serial, "shell", "sgdisk", "--verify", node], timeout=45)
            if print_result.returncode != 0 or verify_result.returncode != 0:
                raise RuntimeError(f"sgdisk could not inspect/verify {disk}: {verify_result.stderr.strip() or verify_result.stdout.strip()}")
            table_path = out_dir / "gpt" / f"{disk}-sgdisk-print.txt"
            table_path.write_text(print_result.stdout, encoding="utf-8")
            verify_path = out_dir / "gpt" / f"{disk}-sgdisk-verify.txt"
            verify_path.write_text(verify_result.stdout + verify_result.stderr, encoding="utf-8")
            files.extend((table_path, verify_path))
            inventory[disk] = {
                "bytes": expected_bytes,
                "logical_block_size": GPT_CAPTURE_BLOCK,
                "sgdisk_backup": gpt_backup.name,
                "sgdisk_backup_bytes": gpt_backup.stat().st_size,
            }

        # Validate primary/backup headers, CRCs and matching arrays from the
        # just-captured edges, using the same parser as the checked-in tool.
        parser_path = Path(__file__).with_name("parse-gpt-capture.py")
        import importlib.machinery
        import importlib.util

        loader = importlib.machinery.SourceFileLoader("x810_gpt_parser", str(parser_path))
        spec = importlib.util.spec_from_loader(loader.name, loader)
        parser = importlib.util.module_from_spec(spec)
        loader.exec_module(parser)
        for disk in X810_LUNS:
            parser.parse_one(out_dir / "gpt", disk)

        document = {
            "schema_version": 1,
            "device_model": EXPECTED_MODEL,
            "device_codename": values["device"],
            "bootloader": values["bootloader"],
            "twrp_version": values["twrp"],
            "captured_at_epoch": int(time.time()),
            "scope": "all six UFS GPT backups and 1 MiB edge captures; partition payloads are not included",
            "luns": inventory,
            "sha256": {str(path.relative_to(out_dir)): sha256_file(path) for path in files},
        }
        (out_dir / "manifest.json").write_text(json.dumps(document, indent=2) + "\n", encoding="utf-8")
        (out_dir / "README.txt").write_text(
            "X810 pre-install GPT backup (read-only capture)\n\n"
            "This directory contains sgdisk binary GPT backups, raw first/last 1 MiB captures, and the full sgdisk partition listing for each of the six UFS LUNs. The captures passed primary/backup header CRC and entry-array agreement checks.\n\n"
            "This is NOT a full partition/data backup and contains no EFS, persist, modem, calibration, or boot partition payloads. Keep it private and off the tablet before repartitioning. No partition was written by this command.\n",
            encoding="utf-8",
        )
        (out_dir / "SHA256SUMS").write_text(
            "".join(f"{sha256_file(path)}  {path.relative_to(out_dir)}\n" for path in files)
            + f"{sha256_file(out_dir / 'manifest.json')}  manifest.json\n",
            encoding="utf-8",
        )
        (out_dir / "COMPLETE.txt").write_text(
            "GPT metadata capture completed; all six edge-capture pairs passed CRC and agreement checks.\n",
            encoding="utf-8",
        )
        os.chmod(out_dir / "manifest.json", 0o600)
        os.chmod(out_dir / "README.txt", 0o600)
        os.chmod(out_dir / "SHA256SUMS", 0o600)
        os.chmod(out_dir / "COMPLETE.txt", 0o600)
        return [Check("GPT backup", "OK", f"{len(files)} files saved and CRC-validated at {out_dir}")]
    except Exception:
        # Leave partial files visible for diagnosis and never silently treat
        # an interrupted capture as a complete backup.
        (out_dir / "INCOMPLETE.txt").write_text("Capture did not finish. Do not use this as a pre-write backup.\n", encoding="utf-8")
        raise


def run_gpt_backup(serial: str | None, out_dir: Path) -> tuple[list[Check], int]:
    adb = shutil.which("adb")
    if not adb:
        return [Check("adb", "STOP", "install Android platform-tools")], 2
    result = command([adb, "devices", "-l"])
    if result.returncode != 0:
        return [Check("ADB server", "STOP", result.stderr.strip() or "adb devices failed")], 2
    targets = adb_serials(result.stdout)
    if serial:
        targets = [target for target in targets if target[0] == serial]
    if len(targets) != 1:
        detail = "no matching recovery device" if not targets else "multiple matching devices; specify --serial"
        return [Check("ADB target", "STOP", detail)], 2
    target_serial, state = targets[0]
    values, checks = twrp_identity(adb, target_serial, state)
    if any(check.state == "STOP" for check in checks):
        return checks, 2
    try:
        checks.extend(save_gpt_backup(adb, target_serial, out_dir, values))
    except (OSError, RuntimeError, ValueError, subprocess.SubprocessError) as error:
        checks.append(Check("GPT backup", "STOP", str(error)))
        return checks, 2
    checks.append(Check("Tablet changes", "OK", "none; only GPT metadata was read and copied to the PC"))
    return checks, 0


def parse_sgdisk_info(text: str) -> dict[str, str] | None:
    """Parse the stable fields emitted by sgdisk --info=N."""
    if "does not exist" in text.lower():
        return None
    fields = {
        "type_guid": r"^Partition GUID code:\s*([0-9A-Fa-f-]+)",
        "unique_guid": r"^Partition unique GUID:\s*([0-9A-Fa-f-]+)",
        "first": r"^First sector:\s*(\d+)",
        "last": r"^Last sector:\s*(\d+)",
        "name": r"^Partition name:\s*'(.*)'\s*$",
    }
    parsed: dict[str, str] = {}
    for key, pattern in fields.items():
        match = re.search(pattern, text, flags=re.MULTILINE)
        if not match:
            return None
        parsed[key] = match.group(1)
    parsed["type_guid"] = parsed["type_guid"].upper()
    parsed["unique_guid"] = parsed["unique_guid"].upper()
    return parsed


def twrp_gpt_layout(adb: str, serial: str, runner=None) -> tuple[dict[str, Any] | None, list[Check]]:
    """Read-only prove the live X810 UFS GPT is stock or our expected split."""
    runner = command if runner is None else runner
    checks: list[Check] = []

    def shell(*args: str, timeout: int = 30) -> subprocess.CompletedProcess[str]:
        return runner([adb, "-s", serial, "shell", *args], timeout=timeout)

    disk = "/dev/block/sda"
    size_result = shell("blockdev", "--getsize64", disk)
    if size_result.returncode != 0 or size_result.stdout.strip() != str(X810_LUNS["sda"]):
        checks.append(Check("Internal UFS", "STOP", f"unexpected sda size: {size_result.stdout.strip() or 'unreadable'}"))
        return None, checks
    block_result = shell("cat", "/sys/class/block/sda/queue/logical_block_size")
    if block_result.returncode != 0 or block_result.stdout.strip() != str(GPT_CAPTURE_BLOCK):
        checks.append(Check("GPT sector size", "STOP", f"expected 4096 bytes, got {block_result.stdout.strip() or 'unreadable'}"))
        return None, checks
    checks.extend((
        Check("Internal UFS", "OK", f"{disk}, {X810_LUNS['sda']:,} bytes"),
        Check("GPT sector size", "OK", "4096 bytes"),
    ))

    print_result = shell("sgdisk", "--print", disk)
    verify_result = shell("sgdisk", "--verify", disk)
    if print_result.returncode != 0 or verify_result.returncode != 0:
        checks.append(Check("GPT validity", "STOP", verify_result.stderr.strip() or verify_result.stdout.strip() or "sgdisk verify failed"))
        return None, checks
    disk_match = re.search(r"^Disk identifier \(GUID\):\s*([0-9A-Fa-f-]+)\s*$", print_result.stdout, re.MULTILINE)
    if not disk_match or disk_match.group(1).upper() != X810_INTERNAL_DISK_GUID:
        checks.append(Check("GPT identity", "STOP", f"expected X810 UFS GUID {X810_INTERNAL_DISK_GUID}; got {disk_match.group(1) if disk_match else 'unknown'}"))
        return None, checks
    checks.append(Check("GPT identity", "OK", X810_INTERNAL_DISK_GUID))

    infos: dict[int, dict[str, str] | None] = {}
    for number in range(34, 41):
        result = shell("sgdisk", f"--info={number}", disk)
        info_text = result.stdout + result.stderr
        parsed = parse_sgdisk_info(info_text)
        if parsed is None and "does not exist" not in info_text.lower():
            checks.append(Check(f"GPT entry {number}", "STOP", result.stderr.strip() or result.stdout.strip() or "could not read partition entry"))
            return None, checks
        infos[number] = parsed

    userdata = infos[34]
    if userdata is None or userdata["name"] != "userdata" or userdata["type_guid"] != X810_USERDATA_TYPE_GUID or int(userdata["first"]) != X810_USERDATA_START:
        checks.append(Check("userdata entry", "STOP", "GPT entry 34 does not match the measured X810 userdata identity/start"))
        return None, checks
    if any(infos[number] is not None for number in range(36, 41)):
        checks.append(Check("GPT entries 36–40", "STOP", "unexpected occupied GPT entry; refusing to touch this layout"))
        return None, checks

    linuxroot = infos[35]
    userdata_last = int(userdata["last"])
    if linuxroot is None:
        if userdata["unique_guid"] != X810_USERDATA_TYPE_GUID:
            checks.append(Check("userdata identity", "STOP", "stock userdata unique GUID does not match measured X810 baseline"))
            return None, checks
        if userdata_last != X810_USERDATA_END:
            checks.append(Check("userdata geometry", "STOP", f"stock end should be {X810_USERDATA_END}; got {userdata_last}"))
            return None, checks
        checks.append(Check("userdata layout", "OK", "measured stock/unsplit X810 geometry"))
        return {
            "state": "stock",
            "userdata": userdata,
            "disk_last": X810_USERDATA_END,
        }, checks

    if linuxroot["name"] != "linuxroot" or linuxroot["type_guid"] != X810_LINUX_TYPE_GUID:
        checks.append(Check("GPT entry 35", "STOP", "occupied by a partition other than the expected linuxroot"))
        return None, checks
    if (int(userdata["last"]) + 1 != int(linuxroot["first"])
            or int(linuxroot["last"]) > X810_USERDATA_END
            or int(linuxroot["last"]) < int(linuxroot["first"])):
        checks.append(Check("split geometry", "STOP", "userdata/linuxroot are not contiguous within the measured original userdata range"))
        return None, checks
    free_sectors = X810_USERDATA_END - int(linuxroot["last"])
    checks.append(Check("userdata layout", "OK", "recognized userdata + linuxroot split" + (f" with {free_sectors * GPT_CAPTURE_BLOCK:,} bytes unallocated" if free_sectors else "")))
    return {
        "state": "split",
        "userdata": userdata,
        "linuxroot": linuxroot,
        "disk_last": X810_USERDATA_END,
    }, checks


def calculate_split(android_percent: int, first_sector: int = X810_USERDATA_START,
                    last_sector: int = X810_USERDATA_END) -> dict[str, int]:
    if not 5 <= android_percent <= 95:
        raise ValueError("Android percentage must be between 5 and 95")
    total = last_sector - first_sector + 1
    android_sectors = total * android_percent // 100
    android_sectors = android_sectors // X810_SPLIT_ALIGNMENT_SECTORS * X810_SPLIT_ALIGNMENT_SECTORS
    userdata_last = first_sector + android_sectors - 1
    linuxroot_first = userdata_last + 1
    linuxroot_sectors = last_sector - linuxroot_first + 1
    if android_sectors <= 0 or linuxroot_sectors <= 0 or linuxroot_first % X810_SPLIT_ALIGNMENT_SECTORS:
        raise ValueError("requested split fails size/alignment checks")
    if android_sectors + linuxroot_sectors != total:
        raise ValueError("split arithmetic does not conserve userdata sectors")
    return {
        "userdata_first": first_sector,
        "userdata_last": userdata_last,
        "userdata_sectors": android_sectors,
        "linuxroot_first": linuxroot_first,
        "linuxroot_last": last_sector,
        "linuxroot_sectors": linuxroot_sectors,
    }


def print_live_split_plan(plan: dict[str, int], android_percent: int) -> None:
    def gib(sectors: int) -> str:
        return f"{sectors * GPT_CAPTURE_BLOCK / (1024 ** 3):.2f} GiB"
    print(f"X810 split preview ({android_percent}% Android / {100 - android_percent}% Fedora):")
    print(f"  userdata  {plan['userdata_first']:,}..{plan['userdata_last']:,}  {gib(plan['userdata_sectors'])}")
    print(f"  linuxroot {plan['linuxroot_first']:,}..{plan['linuxroot_last']:,}  {gib(plan['linuxroot_sectors'])}")
    print("  Only GPT entries 34 and 35 would change; formatting userdata later erases Android data.")


def run_split(serial: str | None, android_percent: int, write: bool = False,
              confirm: str = "", backup_dir: Path | None = None) -> tuple[list[Check], int]:
    """Plan or perform the exact X810 userdata split from TWRP over ADB."""
    try:
        plan = calculate_split(android_percent)
    except ValueError as error:
        return [Check("Split percentage", "STOP", str(error))], 2
    adb = shutil.which("adb")
    if not adb:
        return [Check("adb", "STOP", "install Android platform-tools")], 2
    devices = command([adb, "devices", "-l"])
    if devices.returncode != 0:
        return [Check("ADB server", "STOP", devices.stderr.strip() or "adb devices failed")], 2
    targets = adb_serials(devices.stdout)
    if serial:
        targets = [target for target in targets if target[0] == serial]
    if len(targets) != 1:
        return [Check("ADB target", "STOP", "no matching recovery device" if not targets else "multiple targets; specify --serial")], 2
    target_serial, state = targets[0]
    values, checks = twrp_identity(adb, target_serial, state)
    if any(item.state == "STOP" for item in checks):
        return checks, 2
    layout, layout_checks = twrp_gpt_layout(adb, target_serial)
    checks.extend(layout_checks)
    if layout is None or any(item.state == "STOP" for item in layout_checks):
        return checks, 2
    if layout["state"] == "split":
        userdata_sectors = int(layout["userdata"]["last"]) - int(layout["userdata"]["first"]) + 1
        linuxroot_sectors = int(layout["linuxroot"]["last"]) - int(layout["linuxroot"]["first"]) + 1
        print(f"Already split: userdata {userdata_sectors * GPT_CAPTURE_BLOCK / (1024**3):.2f} GiB, linuxroot {linuxroot_sectors * GPT_CAPTURE_BLOCK / (1024**3):.2f} GiB.")
        checks.append(Check("Partition table", "OK", "expected X810 userdata/linuxroot split already exists; no write made"))
        return checks, 0

    print_live_split_plan(plan, android_percent)
    if not write:
        checks.append(Check("Partition table", "OK", "stock X810 layout verified; plan only, no write"))
        checks.append(Check("Tablet changes", "OK", "none"))
        return checks, 0
    if confirm != SPLIT_CONFIRMATION:
        checks.append(Check("Write confirmation", "STOP", f"to accept Android userdata loss, pass --confirm {SPLIT_CONFIRMATION}"))
        return checks, 2

    output = backup_dir.expanduser() if backup_dir else default_gpt_backup_path()
    try:
        backup_checks = save_gpt_backup(adb, target_serial, output, values)
    except (OSError, RuntimeError, ValueError, subprocess.SubprocessError) as error:
        checks.append(Check("Pre-write GPT backup", "STOP", str(error)))
        return checks, 2
    checks.extend(backup_checks)
    # Recheck geometry immediately before the write. If anything changed after
    # the capture, do not apply sector numbers computed from a stale table.
    second_layout, second_checks = twrp_gpt_layout(adb, target_serial)
    if second_layout is None or second_layout["state"] != "stock" or any(item.state == "STOP" for item in second_checks):
        checks.extend(second_checks)
        checks.append(Check("Pre-write recheck", "STOP", "GPT no longer matches the stock table captured for this operation"))
        return checks, 2
    write_args = [
        adb, "-s", target_serial, "shell", "sgdisk",
        "--delete=34",
        f"--new=34:{plan['userdata_first']}:{plan['userdata_last']}",
        f"--typecode=34:{X810_USERDATA_TYPE_GUID}",
        f"--partition-guid=34:{uuid.uuid4()}",
        "--change-name=34:userdata",
        f"--new=35:{plan['linuxroot_first']}:{plan['linuxroot_last']}",
        f"--typecode=35:{X810_LINUX_TYPE_GUID}",
        "--change-name=35:linuxroot",
        "/dev/block/sda",
    ]
    try:
        write_result = command(write_args, timeout=60)
        if write_result.returncode != 0:
            checks.append(Check("GPT write", "STOP", write_result.stderr.strip() or write_result.stdout.strip() or "sgdisk returned an error"))
            checks.append(Check("Recovery copy", "INFO", f"pre-write GPT capture is at {output}"))
            return checks, 2
        sync_result = command([adb, "-s", target_serial, "shell", "sync"])
        verify = command([adb, "-s", target_serial, "shell", "sgdisk", "--verify", "/dev/block/sda"], timeout=60)
        user_info = command([adb, "-s", target_serial, "shell", "sgdisk", "--info=34", "/dev/block/sda"])
        linux_info = command([adb, "-s", target_serial, "shell", "sgdisk", "--info=35", "/dev/block/sda"])
        actual_user = parse_sgdisk_info(user_info.stdout)
        actual_linux = parse_sgdisk_info(linux_info.stdout)
        final_layout, final_checks = twrp_gpt_layout(adb, target_serial)
        checks.extend(final_checks)
        valid = (
            sync_result.returncode == 0 and verify.returncode == 0
            and actual_user is not None and actual_linux is not None
            and actual_user["name"] == "userdata"
            and actual_user["type_guid"] == X810_USERDATA_TYPE_GUID
            and actual_user["unique_guid"] != X810_USERDATA_TYPE_GUID
            and int(actual_user["first"]) == plan["userdata_first"]
            and int(actual_user["last"]) == plan["userdata_last"]
            and actual_linux["name"] == "linuxroot"
            and actual_linux["type_guid"] == X810_LINUX_TYPE_GUID
            and int(actual_linux["first"]) == plan["linuxroot_first"]
            and int(actual_linux["last"]) == plan["linuxroot_last"]
            and final_layout is not None and final_layout["state"] == "split"
            and int(final_layout["userdata"]["last"]) == plan["userdata_last"]
            and int(final_layout["linuxroot"]["first"]) == plan["linuxroot_first"]
            and int(final_layout["linuxroot"]["last"]) == plan["linuxroot_last"]
        )
        if not valid:
            checks.append(Check("GPT read-back", "STOP", "could not prove the expected entry 34/35 result; do not boot system"))
            checks.append(Check("Recovery copy", "INFO", f"pre-write GPT capture is at {output}"))
            return checks, 2
    except (OSError, RuntimeError, ValueError, subprocess.SubprocessError) as error:
        checks.append(Check("GPT write/read-back", "STOP", f"operation did not complete cleanly: {error}"))
        checks.append(Check("Recovery copy", "INFO", f"pre-write GPT capture is at {output}"))
        return checks, 2

    checks.append(Check("GPT write", "OK", "entries 34 and 35 were written and verified; no other partition entry was selected"))
    checks.append(Check("Recovery copy", "OK", str(output)))
    checks.append(Check("Next step", "WAIT", "reboot to TWRP manually to refresh its partition map; then Format Data. This command does not format or reboot."))
    return checks, 0


def default_gpt_backup_path() -> Path:
    stamp = time.strftime("%Y%m%d-%H%M%S") + f"-{int(time.time() * 1_000_000) % 1_000_000:06d}"
    return Path.cwd() / f"x810-gpt-backup-{stamp}"


def run_split_plan(capture_dir: Path, android_percent: int) -> int:
    """Run the stock-GPT-only planner; this command cannot write to a device."""
    planner = Path(__file__).with_name("plan-x810-split.py")
    try:
        result = command(
            [sys.executable, str(planner), str(capture_dir), "--android-percent", str(android_percent)],
            timeout=20,
        )
    except (OSError, subprocess.SubprocessError) as error:
        print(f"Split plan failed: {error}", file=sys.stderr)
        return 2
    if result.stdout:
        print(result.stdout, end="" if result.stdout.endswith("\n") else "\n")
    if result.stderr:
        print(result.stderr, end="" if result.stderr.endswith("\n") else "\n", file=sys.stderr)
    return result.returncode


@dataclass
class InstallBundle:
    root: Path
    manifest: dict[str, Any]
    rootfs_archive: Path
    rootfs_manifest: Path
    boot_images: dict[str, Path]
    kernel_rpm: Path
    kernel_metadata: Path


def normalize_bundle_path(raw: str) -> str:
    if not isinstance(raw, str) or not raw or "\\" in raw:
        raise ValueError("bundle artifact path must be a non-empty POSIX relative path")
    if raw.startswith("/"):
        raise ValueError(f"absolute path is forbidden in bundle: {raw!r}")
    parts = [part for part in PurePosixPath(raw).parts if part not in ("", ".")]
    if not parts or ".." in parts:
        raise ValueError(f"path traversal/empty path in bundle: {raw!r}")
    return "/".join(parts)


def manifest_artifact(root: Path, record: Any, label: str) -> Path:
    if not isinstance(record, dict):
        raise ValueError(f"{label} must be an artifact object")
    relative = normalize_bundle_path(record.get("file"))
    digest = record.get("sha256")
    size = record.get("size_bytes")
    if not isinstance(digest, str) or not re.fullmatch(r"[0-9a-f]{64}", digest):
        raise ValueError(f"{label} has an invalid SHA-256 value")
    if not isinstance(size, int) or isinstance(size, bool) or size <= 0:
        raise ValueError(f"{label} has invalid size_bytes")
    candidate = root.joinpath(*PurePosixPath(relative).parts)
    # Resolve symlinks as well as '..': manifests may not redirect an install
    # artifact outside the extracted bundle tree.
    try:
        resolved_root = root.resolve(strict=True)
        resolved = candidate.resolve(strict=True)
    except OSError as error:
        raise ValueError(f"{label} is missing: {relative}") from error
    if resolved_root not in resolved.parents or not resolved.is_file():
        raise ValueError(f"{label} is not a regular file inside the bundle: {relative}")
    if resolved.stat().st_size != size:
        raise ValueError(f"{label} size mismatch: manifest {size}, file {resolved.stat().st_size}")
    if sha256_file(resolved) != digest:
        raise ValueError(f"{label} checksum mismatch: {relative}")
    return resolved


