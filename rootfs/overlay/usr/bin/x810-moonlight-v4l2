#!/usr/bin/bash
# Launch installed Moonlight with upstream-supported stateful V4L2 decoder
# hints. The Flatpak grants device access, but a hint only selects an FFmpeg
# decoder implementation; it does not prove which node was opened or that
# decoding succeeded. Do not widen or persist sandbox permissions here.
set -euo pipefail

readonly app_id="com.moonlight_stream.Moonlight"

if ! command -v flatpak >/dev/null 2>&1; then
	echo "x810-moonlight-v4l2: Flatpak is not installed." >&2
	exit 127
fi

if ! flatpak --system info --show-ref "$app_id" >/dev/null 2>&1; then
	echo "x810-moonlight-v4l2: system-installed Moonlight Flatpak was not found." >&2
	exit 1
fi

# The Flathub build includes FFmpeg's stateful V4L2 M2M wrappers, and Moonlight
# upstream consumes these hints before automatic decoder selection. FFmpeg
# still probes an appropriate device; these variables do not bind /dev/video17
# or attest that Moonlight opened it. Moonlight may not report this decoder as
# "hardware" through its generic decoder-capability checks; keep its decoder
# selection on Automatic for this experiment. H.264 is verified through FFmpeg
# outside Moonlight; HEVC and live-stream use remain unverified. Do not set
# DRM_FORCE_DIRECT: this launcher is for GNOME.
exec flatpak --system run \
	--env=H264_DECODER_HINT=h264_v4l2m2m \
	--env=HEVC_DECODER_HINT=hevc_v4l2m2m \
	"$app_id" "$@"
