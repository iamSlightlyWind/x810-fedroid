[Unit]
Description=X810 profile-aware CPU/GPU performance and temperature limiter
After=systemd-modules-load.service
ConditionPathExists=/sys/class/thermal

[Service]
Type=simple
ExecStart=/usr/libexec/x810-thermal-limit
Restart=on-failure
RestartSec=2s
TimeoutStopSec=10s
UMask=0022
RuntimeDirectory=x810-thermal-limit
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=restart
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/sys/devices/system/cpu/cpufreq /sys/class/devfreq/3d00000.gpu /sys/devices/platform/soc@0/3d00000.gpu/devfreq /run/x810-thermal-limit
ReadOnlyPaths=/sys/class/thermal

[Install]
WantedBy=multi-user.target
