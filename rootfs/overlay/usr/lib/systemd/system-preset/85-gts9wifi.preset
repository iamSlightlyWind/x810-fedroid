# Enablement policy for this port's units.  systemd-preset-all runs on first
# boot and strips enablement from anything without a preset entry, which is
# how the first Fedora boot silently lost the whole device stack.
#
# The remoteproc boot helper is not standalone-enabled; enabled clients such
# as pd-mapper/rootpd may pull it in, but its drop-in requires and follows the
# panel cold-boot recovery and the read-only firmware mount. Keep sensorspd
# disabled as a standalone unit: it is attached only through the later,
# panel-ordered sensor-proxy recovery path.
enable sshd.service
enable NetworkManager.service
enable hexagonrpcd-adsp-rootpd.service
enable pd-mapper.service
enable gts9wifi-bt-provision.service
enable gts9wifi-bt-address.service
enable gts9wifi-mem-reclaim.service
enable gts9wifi-wait-sensor-proxy.service
enable gts9wifi-panel-coldboot-recover.service
enable gts9wifi-grow-rootfs.service
enable gts9wifi-usb-net.service
enable gts9wifi-wifi-recover.service
enable gts9wifi-sensor-registry-perms.service
enable gts9wifi-x11-dir-fix.path
enable gts9wifi-device-control.service
enable x810-thermal-limit.service
enable gts9wifi-chronyd.service
enable mnt-vendor-persist.mount
enable gts9wifi-android-parts.service
enable vendor.mount
enable vendor-dsp.mount
enable vendor-firmware_mnt.mount
enable tuned.service
enable tuned-ppd.service
disable gts9wifi-adsp-boot.service
disable hexagonrpcd-adsp-sensorspd.service
