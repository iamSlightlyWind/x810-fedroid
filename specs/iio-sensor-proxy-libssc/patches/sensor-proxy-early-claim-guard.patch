During slow SSC discovery, iio-sensor-proxy owns its D-Bus name and iterates
the main context. Mutter can claim the accelerometer while discovery is in
flight, before the SensorDevice is opened. Initialize claim tables and delayed
invocation arrays before registering the D-Bus objects, and only touch an open
device in the claim handler. Once discovery opens a sensor that was already
claimed, start polling it. Without this ordering/guard, startup can dereference
a NULL delayed-invocation array or SensorDevice, or lose the early claim and
leave auto-rotation without measurements.

diff --git a/src/iio-sensor-proxy.c b/src/iio-sensor-proxy.c
index 70a72f0..cc12a94 100644
--- a/src/iio-sensor-proxy.c
+++ b/src/iio-sensor-proxy.c
@@ -520,7 +520,8 @@ handle_generic_method_call (SensorData            *data,
 							   NULL);
 		g_hash_table_insert (ht, g_strdup (sender), GUINT_TO_POINTER (watch_id));
 
-		if (driver_type_exists (data, driver_type)) {
+		if (driver_type_exists (data, driver_type) &&
+		    DEVICE_FOR_TYPE(driver_type) != NULL) {
 			SensorDevice *sensor_device = DEVICE_FOR_TYPE(driver_type);
 
 			/* No other clients for this sensor? Start it */
@@ -721,6 +722,16 @@ bus_acquired_handler (GDBusConnection *connection,
     };
 	guint i;
 
+	/* Initialize claim bookkeeping before exposing either D-Bus object.
+	 * Slow SSC discovery iterates the main context, so a client can claim
+	 * the accelerometer while name_acquired_handler() is still running.
+	 */
+	data->client = g_udev_client_new (subsystems);
+	for (i = 0; i < NUM_SENSOR_TYPES; i++) {
+		data->clients[i] = create_clients_hash_table ();
+		data->sensor_startup_dbus_invocations_delayed[i] = g_ptr_array_new ();
+	}
+
 	g_dbus_connection_register_object (connection,
 					   SENSOR_PROXY_DBUS_PATH,
 					   data->introspection_data->interfaces[0],
@@ -737,12 +748,6 @@ bus_acquired_handler (GDBusConnection *connection,
 					   NULL,
 					   NULL);
 
-	/* Initialize DBus clients hash table before DBus is fully exposed */
-	data->client = g_udev_client_new (subsystems);
-
-	for (guint i = 0; i < NUM_SENSOR_TYPES; i++)
-		data->clients[i] = create_clients_hash_table ();
-
 	data->connection = g_object_ref (connection);
 }
 
@@ -763,8 +768,6 @@ name_acquired_handler (GDBusConnection *connection,
 	for (i = 0; i < NUM_SENSOR_TYPES; i++) {
 		SensorDevice *sensor_device;
 
-		data->sensor_startup_dbus_invocations_delayed[i] = g_ptr_array_new ();
-
 		if (!driver_type_exists (data, i))
 			continue;
 
