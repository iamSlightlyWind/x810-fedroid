Wait for SSC replies without spinning a CPU core.

ssc_common_wait_sync_context() iterates the default GLib context with
may_block=FALSE, which polls with a zero timeout while waiting for an SSC
reply. The owning thread can instead block in the callback's thread-default
context; a non-owner waits on the condition variable signaled by completion.

diff --git a/src/libssc-common.c b/src/libssc-common.c
index 3648f47..3fbca7a 100644
--- a/src/libssc-common.c
+++ b/src/libssc-common.c
@@ -50,13 +50,41 @@ ssc_common_init_sync_context (SyncContext *ctx) {

 void
 ssc_common_wait_sync_context (SyncContext *ctx) {
+	GMainContext *context = g_main_context_ref_thread_default ();
+	gboolean owner;
+
+	/*
+	 * Iterating the context without blocking makes this a spin rather than a
+	 * wait: GLib forces the poll timeout to zero whenever may_block is FALSE,
+	 * so the loop runs as fast as the CPU allows.  A stalled SSC request can
+	 * therefore pin a core until its lower-level QMI timeout is dispatched.
+	 *
+	 * Block in poll() instead.  GTask dispatches the completion callback in
+	 * the caller's thread-default context, so drive that exact context.  GLib
+	 * sleeps until a source wakes it and continues dispatching other sources;
+	 * this wait returns only after the completion callback sets `finished`.
+	 *
+	 * If this thread can own the context, drive it until the callback runs.
+	 * If another thread currently owns it, sleep on the condition the callback
+	 * signals instead of competing for context iterations.
+	 */
+	owner = g_main_context_acquire (context);
+
 	g_mutex_lock (&ctx->mutex);
 	while (!ctx->finished) {
-		g_mutex_unlock (&ctx->mutex);
-		g_main_context_iteration (g_main_context_default (), FALSE);
-		g_mutex_lock (&ctx->mutex);
+		if (owner) {
+			g_mutex_unlock (&ctx->mutex);
+			g_main_context_iteration (context, TRUE);
+			g_mutex_lock (&ctx->mutex);
+		} else {
+			g_cond_wait (&ctx->condition, &ctx->mutex);
+		}
 	}
 	g_mutex_unlock (&ctx->mutex);
+
+	if (owner)
+		g_main_context_release (context);
+	g_main_context_unref (context);
 }

 void
