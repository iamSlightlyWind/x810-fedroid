# Extracted device assets never belong in git (blobs + size):
# firmware payload, kernel modules, boot images, ssh keys.
local-assets/

# Build output
out/
build/
_ci/
.local/
artifacts/

# Disk images
*.img
*.img.xz
*.raw

# Never commit firmware blobs even outside local-assets
firmware-samsung-gts9wifi.tar.gz

# Local scratch / sibling project — never tracked here
assets/
ubuntu-galaxy-tab-s9-ultra/

# Pi agent tooling
.pi/

# The project wiki
.llm-wiki/

# Build outputs / checksums / large blobs
SHA256SUMS
gts9wifi-fedora-*.tar.gz
gts9wifi-fedora-*.zip
x810-fedora-*-rootfs.tar.gz
x810-fedora-bootset-*.zip
x810-release-manifest.json
FULL-SET-BUILD-KEY.txt

# X810 live-device evidence and generated artifacts
work/
probes/android-baseline/*
!probes/android-baseline/README.md
probes/twrp-current/
x810-gpt-backup-*/
# Private backups emitted by the installer (boot images, GPT captures,
# serial/device metadata and install checkpoints); never publish these.
x810-install-backup-*/
*.tar.lz4
*.img
*.bin
# Owner-authorized, SHA-256-pinned X810 CYG1 GPU firmware redistributed by this port.
!firmware/x810-cyg1/gmu_gen70200.bin
# Owner-authorized X810 CYG1 VPU payload for reproducible image and RPM builds.
!firmware/x810-vpu-cyg1/vpu30_4v.mbn
*.log
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage*
.DS_Store
*.swp
